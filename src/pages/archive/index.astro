---
import EmptyState from '../../components/EmptyState.astro';
import PostYearGroup from '../../components/PostYearGroup.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getSortedPosts, groupPostsByYear } from '../../lib/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';

const archiveGroups = groupPostsByYear(await getSortedPosts());
---

<BaseLayout title={`归档 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} shell="page">
	<section class="archive" aria-labelledby="archive-title">
		<h1 id="archive-title" class="sr-only">文章归档</h1>
		{
			archiveGroups.length > 0 ? (
				archiveGroups.map((yearGroup) => (
					<PostYearGroup year={yearGroup.year} posts={yearGroup.posts} idPrefix="archive-year" />
				))
			) : (
				<EmptyState
					title="归档还是空的"
					description="时间线正在等待第一篇文章。"
					command="timeline --posts"
				/>
			)
		}
	</section>
</BaseLayout>

<style>
	.archive {
		width: 100%;
	}
</style>

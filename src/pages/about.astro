---
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Comments from '../components/Comments.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`关于 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} shell="page">
	<section class="about" aria-labelledby="about-title">
		<h1 id="about-title" class="sr-only">About Me</h1>
		<div class="about__media" aria-label="头像与微信联系方式">
			<img
				class="about__wechat"
				src="/wechat-contact.png"
				alt="p1g3 的微信加好友二维码"
				width="220"
				height="351"
			/>
		</div>
		<div class="about__intro">
			<p>
				我的 ID 是 p1g3，毕业于 <a class="text-link" href="https://www.cuit.edu.cn/" target="_blank" rel="noreferrer">成信大</a>，大学实验室为 <a class="text-link" href="https://github.com/D0g3-Lab" target="_blank" rel="noreferrer">D0g3</a>。
			</p>
			<p>
				小时候妈妈总喜欢叫我猪头三，于是我结合实验室的名称想了这么个奇怪的 ID，沿用至今🤣
			</p>
			<p>
				我喜欢打游戏，尤其喜欢竞技类游戏。相比输赢，我更喜欢不断逼近极限的过程，曾登上守望先锋 500 强，也进入过英雄联盟手游国服前 200。
			</p>
			<p>
				工作之外，我也会和 <a class="text-link" href="https://github.com/openai/codex" target="_blank" rel="noreferrer">Codex</a>、<a class="text-link" href="https://github.com/anthropics/claude-code" target="_blank" rel="noreferrer">Claude Code</a>、<a class="text-link" href="https://github.com/sst/opencode" target="_blank" rel="noreferrer">OpenCode</a> 这些伙伴一起折腾安全研究：漏洞挖掘、安全建设、整理想法，也把过程中踩过的坑和新的理解慢慢写在这里。如果你也对这些内容感兴趣，欢迎加我微信交流。
			</p>
		</div>
	</section>
	<div class="about__comments-rule" aria-hidden="true"></div>
	<Comments />
</BaseLayout>

<style>
	.about {
		width: 100%;
	}

	.about__media {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: clamp(2rem, 8vw, 5rem);
		margin-bottom: 2.25rem;
	}

	.about__wechat {
		width: clamp(8.5rem, 22vw, 11.25rem);
		height: auto;
		border-radius: 0;
		object-fit: contain;
	}

	.about__intro {
		max-width: none;
		margin: 0;
		color: var(--color-text);
		font-size: 1.2rem;
		line-height: 1.9;
		text-align: left;
	}

	.about__intro p {
		margin: 0 0 1.05rem;
	}

	.about__intro p:last-child {
		margin-bottom: 0;
	}

	.about__comments-rule {
		margin-top: calc(var(--space-page) * 2);
		border-top: 1px solid var(--color-border-strong);
	}

	@media (max-width: 560px) {
		.about__media {
			flex-direction: column;
			gap: 1.25rem;
			margin-bottom: 1.75rem;
		}

		.about__intro {
			font-size: 1.08rem;
		}
	}
</style>

---
import { createCipheriv, pbkdf2Sync, randomBytes } from 'node:crypto';
import type { ProtectedPayload } from '../lib/protected-content';

interface Props {
	password?: string;
	articleId: string;
	payload?: ProtectedPayload;
}

const { password, articleId, payload: sealedPayload } = Astro.props;
const PBKDF2_ITERATIONS = 600_000;

let payload: ProtectedPayload;

const context = `blog:${articleId}`;

if (sealedPayload) {
	if (sealedPayload.context !== context) {
		throw new Error(`[PasswordGate] 密文与文章 “${articleId}” 不匹配。`);
	}

	payload = sealedPayload;
} else {
	if (!password || password.length < 8) {
		throw new Error(`[PasswordGate] 文章 “${articleId}” 的密码至少需要 8 个字符。`);
	}

	const plaintext = await Astro.slots.render('default');
	const salt = randomBytes(16);
	const iv = randomBytes(12);
	const key = pbkdf2Sync(password, salt, PBKDF2_ITERATIONS, 32, 'sha256');
	const cipher = createCipheriv('aes-256-gcm', key, iv);

	cipher.setAAD(Buffer.from(context, 'utf8'));

	const encrypted = Buffer.concat([
		cipher.update(Buffer.from(plaintext, 'utf8')),
		cipher.final(),
		cipher.getAuthTag(),
	]);

	payload = {
		version: 1,
		context,
		kdf: {
			name: 'PBKDF2',
			hash: 'SHA-256',
			iterations: PBKDF2_ITERATIONS,
			salt: salt.toString('base64'),
		},
		cipher: {
			name: 'AES-GCM',
			iv: iv.toString('base64'),
			tagLength: 128,
		},
		ciphertext: encrypted.toString('base64'),
	};
}

const inputId = `article-password-${articleId.replace(/[^a-zA-Z0-9_-]/g, '-')}`;
const payloadJson = JSON.stringify(payload).replaceAll('<', '\\u003c');
---

<section class="password-gate" data-password-gate data-state="checking-cache">
	<div class="password-gate__panel" data-password-panel hidden>
		<form class="password-gate__form" data-password-form>
			<label class="sr-only" for={inputId}>文章密码</label>
			<div class="password-gate__controls">
				<input
					id={inputId}
					name="password"
					type="password"
					placeholder="密码"
					autocomplete="current-password"
					required
					data-password-input
				/>
				<button type="submit" data-password-submit>解锁</button>
			</div>
			<p class="password-gate__status" role="status" aria-live="polite" data-password-status></p>
		</form>
	</div>
	<noscript>需要启用 JavaScript 才能在浏览器中解密这篇文章。</noscript>
	<script type="application/json" data-password-payload set:html={payloadJson}></script>
	<div class="password-gate__content" data-password-content hidden tabindex="-1"></div>
</section>

<script>
	interface EncryptedPayload {
		version: 1;
		context: string;
		kdf: {
			name: 'PBKDF2';
			hash: 'SHA-256';
			iterations: number;
			salt: string;
		};
		cipher: {
			name: 'AES-GCM';
			iv: string;
			tagLength: 128;
		};
		ciphertext: string;
	}

	const decodeBase64 = (value: string) =>
		Uint8Array.from(window.atob(value), (character) => character.charCodeAt(0));

	const PASSWORD_CACHE_DB = 'p1g3-protected-content';
	const PASSWORD_CACHE_STORE = 'password-material';
	const PASSWORD_CACHE_VERSION = 1;
	const PASSWORD_CACHE_TTL = 7 * 24 * 60 * 60 * 1000;

	interface CachedPasswordMaterial {
		context: string;
		passwordMaterial: CryptoKey;
		expiresAt: number;
	}

	const openPasswordCache = () =>
		new Promise<IDBDatabase>((resolve, reject) => {
			const request = window.indexedDB.open(PASSWORD_CACHE_DB, PASSWORD_CACHE_VERSION);

			request.onupgradeneeded = () => {
				if (!request.result.objectStoreNames.contains(PASSWORD_CACHE_STORE)) {
					request.result.createObjectStore(PASSWORD_CACHE_STORE, { keyPath: 'context' });
				}
			};
			request.onsuccess = () => resolve(request.result);
			request.onerror = () => reject(request.error);
		});

	const runPasswordCacheTransaction = async <T>(
		mode: IDBTransactionMode,
		operation: (store: IDBObjectStore) => IDBRequest<T>,
	) => {
		const database = await openPasswordCache();

		try {
			return await new Promise<T>((resolve, reject) => {
				const transaction = database.transaction(PASSWORD_CACHE_STORE, mode);
				const request = operation(transaction.objectStore(PASSWORD_CACHE_STORE));
				let result: T | undefined;

				request.onsuccess = () => {
					result = request.result;
				};
				transaction.oncomplete = () => resolve(result as T);
				transaction.onerror = () => reject(transaction.error);
				transaction.onabort = () => reject(transaction.error);
			});
		} finally {
			database.close();
		}
	};

	const readCachedPasswordMaterial = async (context: string) => {
		try {
			const record = await runPasswordCacheTransaction<CachedPasswordMaterial | undefined>(
				'readonly',
				(store) => store.get(context),
			);

			if (!record || record.expiresAt <= Date.now()) {
				return null;
			}

			return record.passwordMaterial;
		} catch {
			return null;
		}
	};

	const writeCachedPasswordMaterial = async (
		context: string,
		passwordMaterial: CryptoKey,
	) => {
		try {
			await runPasswordCacheTransaction(
				'readwrite',
				(store) => store.put({
					context,
					passwordMaterial,
					expiresAt: Date.now() + PASSWORD_CACHE_TTL,
				} satisfies CachedPasswordMaterial),
			);
		} catch {
			// Persistent storage may be unavailable; unlocking still works for this visit.
		}
	};

	const deleteCachedPasswordMaterial = async (context: string) => {
		try {
			await runPasswordCacheTransaction('readwrite', (store) => store.delete(context));
		} catch {
			// An unavailable cache must not block the password form.
		}
	};

	const importPasswordMaterial = (password: string) =>
		window.crypto.subtle.importKey(
			'raw',
			new TextEncoder().encode(password),
			'PBKDF2',
			false,
			['deriveKey'],
		);

	const decryptArticle = async (
		passwordMaterial: CryptoKey,
		payload: EncryptedPayload,
	) => {
		const key = await window.crypto.subtle.deriveKey(
			{
				name: payload.kdf.name,
				hash: payload.kdf.hash,
				iterations: payload.kdf.iterations,
				salt: decodeBase64(payload.kdf.salt),
			},
			passwordMaterial,
			{ name: payload.cipher.name, length: 256 },
			false,
			['decrypt'],
		);
		const plaintext = await window.crypto.subtle.decrypt(
			{
				name: payload.cipher.name,
				iv: decodeBase64(payload.cipher.iv),
				tagLength: payload.cipher.tagLength,
				additionalData: new TextEncoder().encode(payload.context),
			},
			key,
			decodeBase64(payload.ciphertext),
		);

		return new TextDecoder().decode(plaintext);
	};

	for (const gate of document.querySelectorAll<HTMLElement>('[data-password-gate]')) {
		if (gate.dataset.initialized === 'true') {
			continue;
		}

		gate.dataset.initialized = 'true';

		const form = gate.querySelector<HTMLFormElement>('[data-password-form]');
		const input = gate.querySelector<HTMLInputElement>('[data-password-input]');
		const submit = gate.querySelector<HTMLButtonElement>('[data-password-submit]');
		const status = gate.querySelector<HTMLElement>('[data-password-status]');
		const panel = gate.querySelector<HTMLElement>('[data-password-panel]');
		const content = gate.querySelector<HTMLElement>('[data-password-content]');
		const payloadElement = gate.querySelector<HTMLScriptElement>('[data-password-payload]');

		if (!form || !input || !submit || !status || !panel || !content || !payloadElement) {
			continue;
		}

		const payload = JSON.parse(payloadElement.textContent ?? '') as EncryptedPayload;
		const showPasswordForm = () => {
			panel.hidden = false;
			gate.dataset.state = 'idle';
		};
		const showContent = (html: string) => {
			content.innerHTML = html;
			content.hidden = false;
			panel.remove();
			payloadElement.remove();
			gate.dataset.state = 'unlocked';
			content.focus({ preventScroll: true });
			document.dispatchEvent(
				new CustomEvent('blog:content-unlocked', {
					detail: { root: content },
				}),
			);
		};

		void (async () => {
			const passwordMaterial = await readCachedPasswordMaterial(payload.context);

			if (!passwordMaterial) {
				showPasswordForm();
				return;
			}

			try {
				showContent(await decryptArticle(passwordMaterial, payload));
			} catch {
				await deleteCachedPasswordMaterial(payload.context);
				showPasswordForm();
			}
		})();

		input.addEventListener('input', () => {
			status.textContent = '';
			gate.dataset.state = 'idle';
		});

		form.addEventListener('submit', async (event) => {
			event.preventDefault();

			if (!input.value) {
				input.focus();
				return;
			}

			submit.disabled = true;
			submit.textContent = '解锁中…';
			status.textContent = '';
			gate.dataset.state = 'working';

			try {
				const passwordMaterial = await importPasswordMaterial(input.value);
				const html = await decryptArticle(passwordMaterial, payload);

				showContent(html);
				void writeCachedPasswordMaterial(payload.context, passwordMaterial);
			} catch {
				input.value = '';
				status.textContent = '密码错误，请重新输入。';
				gate.dataset.state = 'error';
				input.focus();
			} finally {
				submit.disabled = false;
				submit.textContent = '解锁';
			}
		});
	}
</script>

<style>
	.password-gate {
		margin: var(--prose-paragraph-gap) 0;
	}

	.password-gate__panel {
		width: min(100%, 22rem);
	}

	.password-gate__form {
		margin: 0;
	}

	.password-gate__controls {
		display: grid;
		grid-template-columns: minmax(0, 14rem) auto;
		gap: 0.5rem;
	}

	.password-gate__controls input {
		min-width: 0;
		padding: 0.5rem 0.65rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background: var(--color-background);
		color: var(--color-text);
		font-size: 0.95rem;
		line-height: 1.3;
	}

	.password-gate__controls input:focus {
		border-color: var(--color-accent);
		outline: none;
	}

	.password-gate__controls button {
		padding: 0.5rem 0.8rem;
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius-sm);
		background: var(--color-background);
		color: var(--color-text);
		cursor: pointer;
		font-size: 0.9rem;
		font-weight: 700;
		line-height: 1.3;
	}

	.password-gate__controls button:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	.password-gate__controls button:disabled {
		cursor: wait;
		opacity: 0.65;
	}

	.password-gate__status {
		min-height: 1.3em;
		margin-top: 0.35rem !important;
		font-size: 0.85rem;
	}

	.password-gate[data-state='error'] .password-gate__status {
		color: #b42318;
	}

	.password-gate__content:focus {
		outline: none;
	}

	@media (max-width: 560px) {
		.password-gate__controls {
			grid-template-columns: minmax(0, 1fr) auto;
		}
	}
</style>

---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings?: Heading[];
}

interface TocSection extends Heading {
	children: Heading[];
}

interface TocGroup extends Heading {
	children: TocSection[];
}

const formatTopNumber = (index: number) => `0x${index.toString(16).padStart(2, '0').toUpperCase()}`;
const formatSectionNumber = (groupIndex: number, sectionIndex: number) =>
	`${groupIndex}.${sectionIndex + 1}`;
const formatChildNumber = (groupIndex: number, sectionIndex: number, childIndex: number) =>
	`${formatSectionNumber(groupIndex, sectionIndex)}.${childIndex + 1}`;

const headings =
	Astro.props.headings?.filter((heading) => heading.depth >= 2 && heading.depth <= 4) ?? [];

const groups: TocGroup[] = [];
let currentGroup: TocGroup | undefined;
let currentSection: TocSection | undefined;

for (const heading of headings) {
	if (heading.depth === 2) {
		currentGroup = { ...heading, children: [] };
		groups.push(currentGroup);
		currentSection = undefined;
		continue;
	}

	if (heading.depth === 3 && currentGroup) {
		currentSection = { ...heading, children: [] };
		currentGroup.children.push(currentSection);
		continue;
	}

	if (heading.depth === 4 && currentSection) {
		currentSection.children.push(heading);
	}
}
---

<nav class="toc" aria-label="Table of Contents" data-toc hidden={groups.length === 0}>
	<div class="toc__title">Table of Contents</div>
	<ol class="toc__list" data-toc-list>
		{groups.map((heading, groupIndex) => (
			<li class="toc__group" data-toc-group={heading.slug}>
				<a
					href={`#${heading.slug}`}
					title={heading.text}
					data-depth={heading.depth}
					data-toc-link={heading.slug}
					data-toc-parent={heading.slug}
				>
					{formatTopNumber(groupIndex)} {heading.text}
				</a>
				{heading.children.length > 0 && (
					<div class="toc__children">
						<ol class="toc__children-list">
							{heading.children.map((section, sectionIndex) => (
								<li>
									<a
										href={`#${section.slug}`}
										title={section.text}
										data-depth={section.depth}
										data-toc-link={section.slug}
										data-toc-parent={heading.slug}
									>
										{formatSectionNumber(groupIndex, sectionIndex)} {section.text}
									</a>
									{section.children.length > 0 && (
										<ol class="toc__grandchildren-list">
											{section.children.map((child, childIndex) => (
												<li>
													<a
														href={`#${child.slug}`}
														title={child.text}
														data-depth={child.depth}
														data-toc-link={child.slug}
														data-toc-parent={heading.slug}
													>
														{formatChildNumber(groupIndex, sectionIndex, childIndex)} {child.text}
													</a>
												</li>
											))}
										</ol>
									)}
								</li>
							))}
						</ol>
					</div>
				)}
			</li>
		))}
	</ol>
</nav>

<script>
	const toc = document.querySelector<HTMLElement>('[data-toc]');
	const tocList = toc?.querySelector<HTMLOListElement>('[data-toc-list]');

	const createLink = (heading: HTMLElement, parent: string, number: string) => {
		const link = document.createElement('a');
		link.href = `#${heading.id}`;
		link.title = heading.textContent?.trim() ?? '';
		link.textContent = `${number} ${link.title}`;
		link.dataset.depth = heading.tagName.slice(1);
		link.dataset.tocLink = heading.id;
		link.dataset.tocParent = parent;
		return link;
	};

	const buildToc = (root: ParentNode) => {
		if (!tocList || tocList.children.length > 0) return;

		let currentGroup: HTMLLIElement | null = null;
		let currentSection: HTMLLIElement | null = null;
		let groupIndex = -1;
		let sectionIndex = -1;
		let childIndex = -1;
		for (const heading of root.querySelectorAll<HTMLElement>('h2[id], h3[id], h4[id]')) {
			if (heading.tagName === 'H2') {
				groupIndex += 1;
				sectionIndex = -1;
				childIndex = -1;
				currentGroup = document.createElement('li');
				currentGroup.className = 'toc__group';
				currentGroup.dataset.tocGroup = heading.id;
				currentGroup.append(
					createLink(heading, heading.id, `0x${groupIndex.toString(16).padStart(2, '0').toUpperCase()}`),
				);
				tocList.append(currentGroup);
				currentSection = null;
				continue;
			}

			if (!currentGroup) continue;

			if (heading.tagName === 'H4') {
				if (!currentSection) continue;
				childIndex += 1;
				let grandchildren = currentSection.querySelector<HTMLOListElement>(
					'.toc__grandchildren-list',
				);
				if (!grandchildren) {
					grandchildren = document.createElement('ol');
					grandchildren.className = 'toc__grandchildren-list';
					currentSection.append(grandchildren);
				}

				const item = document.createElement('li');
				item.append(
					createLink(
						heading,
						currentGroup.dataset.tocGroup ?? '',
						`${groupIndex}.${sectionIndex + 1}.${childIndex + 1}`,
					),
				);
				grandchildren.append(item);
				continue;
			}

			sectionIndex += 1;
			childIndex = -1;

			let children = currentGroup.querySelector<HTMLOListElement>('.toc__children-list');
			if (!children) {
				const wrapper = document.createElement('div');
				wrapper.className = 'toc__children';
				children = document.createElement('ol');
				children.className = 'toc__children-list';
				wrapper.append(children);
				currentGroup.append(wrapper);
			}

			const item = document.createElement('li');
			item.append(
				createLink(
					heading,
					currentGroup.dataset.tocGroup ?? '',
					`${groupIndex}.${sectionIndex + 1}`,
				),
			);
			children.append(item);
			currentSection = item;
		}
	};

	const scrollToHashHeading = (root: ParentNode) => {
		const rawHash = window.location.hash.slice(1);
		if (!rawHash) return;

		let decodedHash = rawHash;
		try {
			decodedHash = decodeURIComponent(rawHash);
		} catch {
			decodedHash = rawHash;
		}

		const heading = document.getElementById(rawHash) ?? document.getElementById(decodedHash);
		if (!heading || !root.contains(heading)) return;

		window.requestAnimationFrame(() => heading.scrollIntoView({ block: 'start' }));
	};

	const activateToc = () => {
		if (!toc || !tocList || toc.dataset.ready === 'true') return;

		const tocLinks = Array.from(tocList.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
		const tocGroups = Array.from(tocList.querySelectorAll<HTMLElement>('[data-toc-group]'));
		const headings = tocLinks
			.map((link) => {
				const slug = link.dataset.tocLink;
				const heading = slug ? document.getElementById(slug) : null;
				return heading ? { heading, link } : null;
			})
			.filter((item): item is { heading: HTMLElement; link: HTMLAnchorElement } => Boolean(item));

		if (headings.length === 0) return;

		toc.hidden = false;
		toc.dataset.ready = 'true';

		const setActiveLink = (slug: string, expandGroup = true) => {
			const activeLink = tocLinks.find((link) => link.dataset.tocLink === slug);
			const activeParent = activeLink?.dataset.tocParent;

			for (const link of tocLinks) {
				link.classList.toggle('active', link.dataset.tocLink === slug);
			}

			for (const group of tocGroups) {
				group.classList.toggle('expanded', expandGroup && group.dataset.tocGroup === activeParent);
			}
		};

		const getHashSlug = () => {
			const rawHash = window.location.hash.slice(1);

			if (!rawHash) {
				return null;
			}

			let decodedHash = rawHash;

			try {
				decodedHash = decodeURIComponent(rawHash);
			} catch {
				decodedHash = rawHash;
			}

			const hashHeading = headings.find(
				({ heading }) => heading.id === rawHash || heading.id === decodedHash,
			);

			return hashHeading?.heading.id ?? null;
		};

		const updateActiveLink = (expandGroup = true, preferHash = false) => {
			const anchorOffset = 64;
			const hashSlug = getHashSlug();
			const isAtPageEnd =
				window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;

			if (preferHash && hashSlug) {
				setActiveLink(hashSlug, expandGroup);
				return;
			}

			if (isAtPageEnd) {
				setActiveLink(headings.at(-1)?.heading.id ?? headings[0].heading.id, expandGroup);
				return;
			}

			let activeHeading = headings[0].heading;

			for (const { heading } of headings) {
				if (heading.getBoundingClientRect().top <= anchorOffset) {
					activeHeading = heading;
				} else {
					break;
				}
			}

			setActiveLink(activeHeading.id, expandGroup);
		};

		let frame = 0;
		const requestUpdate = () => {
			window.cancelAnimationFrame(frame);
			frame = window.requestAnimationFrame(() => updateActiveLink(true));
		};

		updateActiveLink(Boolean(window.location.hash) || window.scrollY > 20, Boolean(window.location.hash));
		window.addEventListener('scroll', requestUpdate, { passive: true });
		window.addEventListener('hashchange', () => {
			window.setTimeout(() => updateActiveLink(true, true), 120);
		});

		for (const link of tocLinks) {
			link.addEventListener('click', () => {
				const parent = link.dataset.tocParent;
				for (const group of tocGroups) {
					group.classList.toggle('expanded', group.dataset.tocGroup === parent);
				}
				window.setTimeout(() => updateActiveLink(true, true), 120);
			});
		}
	};

	const initializeToc = (root: ParentNode) => {
		buildToc(root);
		activateToc();
	};

	initializeToc(document);
	document.addEventListener('blog:content-unlocked', (event) => {
		const customEvent = event as CustomEvent<{ root?: HTMLElement }>;
		const root = customEvent.detail?.root ?? document;
		initializeToc(root);
		scrollToHashHeading(root);
	});
</script>

<style is:global>
	.toc {
		position: sticky;
		top: 2rem;
		max-height: calc(100vh - 4rem);
		overflow-x: hidden;
		overflow-y: auto;
		padding: 0.95rem;
		border: 1px solid color-mix(in srgb, var(--color-border), transparent 25%);
		border-radius: var(--radius-md);
		background: color-mix(in srgb, var(--color-background), transparent 2%);
		color: var(--color-muted);
		font-size: 0.9rem;
		line-height: 1.45;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	.toc::-webkit-scrollbar {
		display: none;
	}

	.toc__title {
		margin-bottom: 0.85rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid color-mix(in srgb, var(--color-border), transparent 35%);
		color: var(--color-text);
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0;
	}

	.toc__list {
		display: grid;
		gap: 0.15rem;
		margin: 0;
		padding: 0;
		list-style: none;
		min-width: 0;
	}

	.toc li,
	.toc__group {
		min-width: 0;
	}

	.toc__children {
		display: none;
	}

	.toc__group.expanded .toc__children {
		display: block;
		animation: slideDown 0.3s ease-in-out;
	}

	.toc__children-list,
	.toc__grandchildren-list {
		display: grid;
		gap: 0.1rem;
		min-width: 0;
		margin: 0;
		padding: 0;
		overflow: hidden;
		list-style: none;
	}

	.toc a {
		display: block;
		overflow: hidden;
		width: 100%;
		min-width: 0;
		padding: 0.36rem 0.55rem;
		border-radius: var(--radius-sm);
		color: var(--color-muted);
		text-decoration: none;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.toc a[data-depth='3'] {
		padding-left: 1.55rem;
		font-size: 0.84rem;
	}

	.toc a[data-depth='4'] {
		padding-left: 2.55rem;
		font-size: 0.8rem;
	}

	.toc a:hover,
	.toc a.active {
		background: color-mix(in srgb, var(--color-accent), transparent 90%);
		color: var(--color-accent);
	}

	.toc a.active {
		box-shadow: inset 2px 0 0 currentColor;
		font-weight: 700;
	}

	@keyframes slideDown {
		0% {
			opacity: 0;
			transform: translateY(-5px);
		}

		100% {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>

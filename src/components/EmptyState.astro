---
interface Props {
	title?: string;
	description?: string;
	command?: string;
}

const {
	title = '这里还没有内容',
	description = '稿纸正在预热，第一篇文章还在路上。',
	command = 'ls posts',
} = Astro.props;
---

<div class="empty-state">
	<div class="empty-state__terminal" aria-hidden="true">
		<span class="empty-state__prompt">p1g3@blog:~$</span>
		<span>{command}</span>
		<span class="empty-state__cursor"></span>
	</div>
	<p class="empty-state__title">{title}</p>
	<p class="empty-state__description">{description}</p>
</div>

<style>
	.empty-state {
		margin: clamp(2rem, 8vw, 4rem) 0;
		color: var(--color-text);
		text-align: center;
	}

	.empty-state__terminal {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		max-width: 100%;
		padding-bottom: 0.65rem;
		border-bottom: 2px solid var(--color-accent);
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 0.95rem;
		white-space: nowrap;
	}

	.empty-state__prompt {
		color: var(--color-brand);
	}

	.empty-state__cursor {
		width: 0.55em;
		height: 1.1em;
		background: var(--color-accent);
		animation: empty-state-cursor 1.1s steps(2, start) infinite;
	}

	.empty-state__title {
		margin: 1.2rem 0 0;
		font-size: 1.35rem;
		font-weight: 700;
		line-height: 1.5;
	}

	.empty-state__description {
		max-width: 28rem;
		margin: 0.35rem auto 0;
		color: var(--color-muted);
		font-size: 1rem;
		line-height: 1.8;
	}

	@keyframes empty-state-cursor {
		0%,
		45% {
			opacity: 1;
		}

		46%,
		100% {
			opacity: 0;
		}
	}

	@media (max-width: 560px) {
		.empty-state {
			text-align: left;
		}

		.empty-state__terminal {
			white-space: normal;
		}

		.empty-state__description {
			margin-right: 0;
			margin-left: 0;
		}
	}
</style>

---
import { MAIN_NAV_ITEMS, SITE_TAGLINE, SITE_TITLE } from '../consts';

const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
---

<header class="site-header">
	<div class="site-header__inner">
		<div class="site-header__brand">
			<a class="site-header__title" href="/" aria-label={`${SITE_TITLE} 首页`}>{SITE_TITLE}</a>
			<span class="site-header__description">{SITE_TAGLINE}</span>
		</div>
		<nav class="site-header__nav" aria-label="主导航">
			{
				MAIN_NAV_ITEMS.map((item) => (
					<a href={item.href} class:list={{ active: currentPath === item.href }}>
						{item.label}
					</a>
				))
			}
		</nav>
	</div>
</header>

<style>
	.site-header {
		background: var(--color-background);
	}

	.site-header__inner {
		width: var(--width-page);
		max-width: calc(100% - (var(--space-page) * 2));
		margin: auto;
		padding: 0;
		border-bottom: 2px solid var(--color-rule);
	}

	.site-header__brand {
		display: grid;
		gap: 0;
		width: fit-content;
		margin-top: 32px;
		color: var(--color-brand);
	}

	.site-header__title {
		color: inherit;
		text-decoration: none;
	}

	.site-header__title:visited,
	.site-header__title:hover,
	.site-header__title:focus {
		color: inherit;
		text-decoration: none;
	}

	.site-header__title {
		font-family: var(--font-title);
		font-size: 2rem;
		font-weight: 700;
		letter-spacing: 0.01em;
		line-height: 1.1;
	}

	.site-header__description {
		margin-top: 0.45rem;
		color: var(--color-accent);
		font-size: 1rem;
		letter-spacing: 0.02em;
		line-height: 1.4;
	}

	.site-header__nav {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 1rem;
		margin: 6px 0;
		font-size: 1rem;
		font-weight: 700;
		line-height: 1.5;
	}

	.site-header__nav a {
		color: var(--color-link);
		text-decoration: none;
		text-underline-offset: 0.18em;
	}

	.site-header__nav a:hover,
	.site-header__nav a.active {
		color: var(--color-accent);
		text-decoration: underline;
	}

	@media (max-width: 720px) {
		.site-header__inner {
			max-width: 100%;
		}

		.site-header__brand {
			margin-inline: auto;
			text-align: center;
		}

		.site-header__nav {
			justify-content: center;
			width: 100%;
			flex-wrap: wrap;
		}
	}
</style>

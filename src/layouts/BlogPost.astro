---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Comments from '../components/Comments.astro';
import PasswordGate from '../components/PasswordGate.astro';
import PostNavigation from '../components/PostNavigation.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { SITE_DESCRIPTION } from '../consts';
import type { ProtectedPayload } from '../lib/protected-content';
import BaseLayout from './BaseLayout.astro';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

type Props = CollectionEntry<'blog'>['data'] & {
	articleId: string;
	password?: string;
	encryptedPayload?: ProtectedPayload;
	headings?: Heading[];
	previousPost?: {
		title: string;
		href: string;
	};
	nextPost?: {
		title: string;
		href: string;
	};
};

const {
	title,
	description = SITE_DESCRIPTION,
	heroImage,
	protected: isProtected,
	articleId,
	password,
	encryptedPayload,
	headings,
	previousPost,
	nextPost,
} = Astro.props;

if (isProtected && !password && !encryptedPayload) {
	throw new Error(`[BlogPost] 密码文章 “${articleId}” 没有可用密文。`);
}

const pageDescription = isProtected ? '这是一篇密码保护文章。' : description;
---

<BaseLayout title={title} description={pageDescription}>
	<article class="post" id="top">
		<div class="post-toc">
			<TableOfContents headings={isProtected ? undefined : headings} />
		</div>
		{!isProtected && <div class="hero-image">
			{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
		</div>}
		<div class="prose">
			<div class="title">
				<h1>{title}</h1>
			</div>
			{
				isProtected ? (
					<PasswordGate {password} payload={encryptedPayload} {articleId}>
						{heroImage && (
							<div class="hero-image hero-image--protected">
								<Image width={1020} height={510} src={heroImage} alt="" />
							</div>
						)}
						<slot />
					</PasswordGate>
				) : (
					<slot />
				)
			}
			<PostNavigation previousPost={previousPost} nextPost={nextPost} />
			<Comments defer={isProtected} />
		</div>
	</article>
</BaseLayout>

<script>
	import mediumZoom from 'medium-zoom';

	interface TwitterWidgets {
		load: (root?: HTMLElement | Document) => void;
	}

	interface TwitterApi {
		ready?: (callback: () => void) => void;
		widgets?: TwitterWidgets;
	}

	const zoomOptions = {
		background: 'rgba(0, 0, 0, 0.72)',
		margin: 24,
	};

	const attachZoom = (root: ParentNode = document) => {
		const images = root.querySelectorAll<HTMLImageElement>('img:not(.medium-zoom-image)');

		if (images.length > 0) {
			mediumZoom(images, zoomOptions);
		}
	};

	const getTwitterApi = () => (window as typeof window & { twttr?: TwitterApi }).twttr;

	const renderTweets = (root: HTMLElement | Document = document) => {
		if (!root.querySelector('blockquote.twitter-tweet')) {
			return;
		}

		const render = () => getTwitterApi()?.widgets?.load(root);
		const twitterApi = getTwitterApi();

		if (twitterApi?.widgets) {
			twitterApi.ready ? twitterApi.ready(render) : render();
			return;
		}

		let script = document.querySelector<HTMLScriptElement>('#twitter-wjs');

		if (!script) {
			script = document.createElement('script');
			script.id = 'twitter-wjs';
			script.src = 'https://platform.twitter.com/widgets.js';
			script.async = true;
			document.head.append(script);
		}

		script.addEventListener('load', render, { once: true });
	};

	attachZoom(document.querySelector('.prose') ?? document);
	renderTweets();

	document.addEventListener('blog:content-unlocked', (event) => {
		const customEvent = event as CustomEvent<{ root?: HTMLElement }>;
		const root = customEvent.detail?.root ?? document;
		attachZoom(root);
		renderTweets(root);
	});
</script>

<style>
	.post {
		width: var(--width-page);
		max-width: 100%;
		margin: 0 auto;
		position: relative;
	}

	.post-toc {
		position: absolute;
		top: 0;
		bottom: 0;
		left: calc(-17rem - 2rem);
		width: 17rem;
	}

	.hero-image {
		width: 100%;
	}

	.hero-image img {
		display: block;
		width: 100%;
		margin: 0 auto;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-soft);
	}

	.hero-image--protected {
		margin-bottom: var(--prose-paragraph-gap);
	}

	.prose {
		width: 100%;
		max-width: 100%;
		margin: 0 auto;
		padding: var(--space-page) 0;
		color: var(--color-text);
	}

	.title {
		margin-bottom: calc(var(--space-page) * 1.35);
		padding: 0;
		text-align: left;
		line-height: 1;
	}

	.title h1 {
		margin: 0;
		font-size: 2rem;
		font-weight: 600;
	}

	@media (max-width: 1180px) {
		.post-toc {
			display: none;
		}
	}
</style>
